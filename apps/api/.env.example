# @se/api environment. Copy to .env (auto-loaded by --env-file-if-exists).
# Everything is optional in development; nothing sensitive is committed.

# HTTP server
PORT=8787
# Public origin of the website (used for CORS + email links)
APP_URL=http://localhost:4321

# SMTP transport. REQUIRED when NODE_ENV=production — without it the API
# refuses to start, because RFQs would otherwise be silently dropped.
NODE_ENV=development
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# From/To mailboxes. From is always our own domain; the visitor's address is
# sent only in Reply-To. Do not put user input in From.
# SMTP_FROM=Sunline Endeavour <rfq@sunlineendeavour.com>
# SMTP_TO=sales@sunlineendeavour.com

# Optional persistence. When unset, RFQs are delivered by email only.
# DATABASE_URL=postgresql://localhost:5432/sunline_endeavour

# Rate limiting (per client IP)
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=600000
