---
import Base from "../layouts/Base.astro";
import { loadAllProducts } from "@se/content/raw";
import BatchLookup from "../components/islands/BatchLookup";
import "@se/ui/tokens.css";
import "../styles/global.css";

const products = loadAllProducts();
---

<Base title="Batch specification lookup — Sunline Endeavour" description="Find welding electrodes that match your AWS class, diameter, mechanical and chemistry criteria in one lookup.">
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="page-hero__kicker">Specification search</p>
        <h1 class="page-hero__title">Batch specification lookup</h1>
        <p class="page-hero__lede">
          Search the whole range by AWS class, diameter, minimum mechanicals or chemistry
          ceilings. Enter several AWS codes at once for cross-referencing.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <BatchLookup products={products} client:visible />
      </div>
    </section>
  </main>
</Base>
