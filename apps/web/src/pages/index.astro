---
import Base from "../layouts/Base.astro";
import { loadAllProducts } from "@se/content/raw";
import { organizationJsonLd } from "../lib/jsonld";
import "@se/ui/tokens.css";
import "../styles/global.css";

const products = loadAllProducts();
---

<Base>
  <main>
    <section class="hero">
      <div class="container">
        <p class="hero__kicker">Welding Electrode Manufacturer · Tamil Nadu, India</p>
        <h1 class="hero__title">When the Arc Is Perfect,<br />the Weld Speaks.</h1>
        <p class="hero__lede">Engineered consumables for plant engineers, procurement managers and distributors.</p>
      </div>
    </section>

    <section class="section" id="products" aria-labelledby="products-title">
      <div class="container">
        <h2 id="products-title" class="section__title">Product range</h2>
        <ul class="product-list">
          {
            products.map((product) => (
              <li class="product-list__item">
                <a class="product-list__link" href={`/products/${product.slug}`}>
                  <span class="product-list__name">{product.name}</span>
                  <span class="product-list__tagline">{product.tagline}</span>
                  <code class="product-list__class tabular">{product.classification.aws}</code>
                </a>
              </li>
            ))
          }
        </ul>
        <p>
          <a class="product-list__more" href="/products/">Browse the full catalogue with filters →</a>
        </p>
      </div>
    </section>
  </main>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd(Astro.site))} />
</Base>
