# @se/web environment. Copy to .env (Astro auto-loads it).
# Base URL of the RFQ API the browser should POST to.
PUBLIC_API_URL=http://localhost:8787

# Analytics. Leave both unset to ship zero tracking JS (budget-safe).
# Set PUBLIC_ANALYTICS_SCRIPT_URL to a Plausible-compatible tracker and
# PUBLIC_ANALYTICS_DOMAIN to the site domain (goes in data-domain).
# PUBLIC_ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js
# PUBLIC_ANALYTICS_DOMAIN=sunlineendeavour.com
